# EchoMind 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=EchoMind
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=echomind123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# 低于意图阈值时进入澄清路径；RAG 概率达到阈值才执行检索。
INTENT_MIN_CONFIDENCE=0.55
RAG_DECISION_THRESHOLD=0.55

# Dense + BM25 加权 RRF 融合后的 LLM 重排
RAG_LLM_RERANK_ENABLED=true
RAG_RERANK_MAX_CANDIDATES=10
RAG_RERANK_CONTENT_CHARS=1000
RAG_RERANK_TIMEOUT_S=30

# ── 知识库文档摄取 ───────────────────────────────────────────────────────────
# 上传总大小和 PDF 页数限制
KNOWLEDGE_MAX_UPLOAD_MB=30
KNOWLEDGE_MAX_PDF_PAGES=200

# PDF 原生文本判定与扫描页 OCR 参数
PDF_OCR_DPI=220
PDF_NATIVE_MIN_CHARS=40
PDF_NATIVE_MIN_QUALITY=0.75
PDF_OCR_MIN_CONFIDENCE=0.55
PDF_IMAGE_COVERAGE_THRESHOLD=0.35
# 单页渲染像素上限，防止超大画布占用过多内存
PDF_MAX_RENDER_PIXELS=25000000
PDF_DOCUMENT_MIN_QUALITY=0.55

# 分页感知切片参数
KNOWLEDGE_CHUNK_SIZE=700
KNOWLEDGE_CHUNK_OVERLAP=80

# 语义规划器置信度达到该阈值时才启用多 Agent 协作。
COLLABORATION_MIN_CONFIDENCE=0.70

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
ECHOMIND_SKILLS_DIR=./skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
